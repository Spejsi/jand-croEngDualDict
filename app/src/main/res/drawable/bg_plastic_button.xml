<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Donja sjena (3D efekt) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0f172a" />
        </shape>
    </item>

    <!-- Glavni plastični gumb s gradijentom -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#1e3a8a"
                android:centerColor="#1e40af"
                android:endColor="#1d4ed8"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3b82f6" />
        </shape>
    </item>
</layer-list>