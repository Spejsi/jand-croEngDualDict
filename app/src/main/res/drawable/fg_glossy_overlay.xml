<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gornji stakleni 3D odsjaj (Glossy Highlight) -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#CCFFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Unutrašnji 3D rub i donje zasjenjenje -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#77000000"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>