<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded"
    tools:context=".dialog.ExitConfirmationDialogFragment"
    tools:ignore="VisualLintSystemUi,VisualLintOverlap">

    <TextView
        android:id="@+id/tvExitRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exit_confirmation_row_1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:gravity="center"
        tools:ignore="VisualLintSystemUi" />

    <TextView
        android:id="@+id/tvExitRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/exit_confirmation_row_2"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="center"
        tools:ignore="VisualLintSystemUi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmExit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_confirm_3d"
            android:elevation="4dp"
            android:text="@string/exit_button_confirm"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="ButtonStyle,VisualLintButtonSize,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelExit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/exit_button_cancel"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_cancel_3d"
            android:elevation="4dp"
            tools:ignore="ButtonStyle,VisualLintButtonSize" />

    </LinearLayout>

</LinearLayout>